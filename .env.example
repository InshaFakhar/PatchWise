# Copy this file to ".env" and fill in YOUR OWN values.
# ".env" is git-ignored. NEVER put real keys in this example file.

# Which LLM provider to use (decided in Phase 9, PD-09): gemini or groq
LLM_PROVIDER=

# API keys (leave empty here; set real values only in your local .env)
GEMINI_API_KEY=
GROQ_API_KEY=

# Secret used by Flask to sign session cookies (needed in Phase 14)
FLASK_SECRET_KEY=

# Path of the SQLite database file (used from Phase 4)
DATABASE_PATH=data/patchwise.db